# Copiar a .env y completar. Nunca subir el .env al repositorio.

DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/cotiza_plus

# Firma de los JWT: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Cifrado del refresh token de Google:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Orígenes del frontend permitidos (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Google Drive (OAuth 2.0, cliente "Aplicación web" en Google Cloud Console).
# GOOGLE_REDIRECT_URI debe estar registrada tal cual en la consola.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/google/callback
# Carpeta por defecto si la empresa no tiene una propia (opcional)
GOOGLE_DRIVE_FOLDER_ID=

# Revisar Drive automáticamente cada N minutos (0 = solo manual)
INGESTA_INTERVALO_MINUTOS=0
