@startuml clases-modelos
!include _estilo.iuml
skinparam classAttributeIconSize 0
title Cotiza+ · Diagrama de clases: modelos de datos (SQLAlchemy, app/models)

class Empresa {
  id: int
  nombre: str
  rut: str | None
  google_drive_folder_id: str | None
  activa: bool
}
class Usuario {
  id: int
  email: str
  nombre: str
  password_hash: str
  activo: bool
}
class IntegracionGoogleDrive {
  refresh_token_encrypted: str
  activa: bool
  fecha_conexion: datetime
}
class OAuthEstado {
  state: str
  code_verifier: str
}
class Cliente {
  id: int
  nombre: str
  rut: str | None
  email: str | None
}
class Cotizacion {
  id: int
  numero: str
  fecha: date
  subtotal: Decimal
  iva: Decimal
  total: Decimal
  moneda: str
}
class ItemCotizacion {
  linea: int
  codigo: str | None
  descripcion: str
  cantidad: Decimal
  unidad: str | None
  precio_unitario: Decimal | None
  total: Decimal | None
}
class Documento {
  google_drive_id: str
  nombre_archivo: str
  hash_archivo: str | None
  estado: EstadoDocumento
  metodo_extraccion: str | None
  error: str | None
  + url_drive: str | None
}
enum EstadoDocumento {
  PENDIENTE
  PROCESADO
  DUPLICADO
  ERROR
}

Empresa "1" -- "0..*" Usuario
Empresa "1" -- "0..1" IntegracionGoogleDrive
Empresa "1" -- "0..*" OAuthEstado
Empresa "1" -- "0..*" Cliente
Empresa "1" -- "0..*" Cotizacion
Empresa "1" -- "0..*" Documento
Cliente "1" -- "0..*" Cotizacion
Cotizacion "1" *-- "0..*" ItemCotizacion
Cotizacion "0..1" -- "0..*" Documento
Documento --> EstadoDocumento
@enduml
