@startuml secuencia-ingesta
!include _estilo.iuml
autonumber
skinparam maxMessageSize 170
skinparam ParticipantPadding 4
skinparam BoxPadding 4
hide footbox
title Cotiza+ · Secuencia: ingesta de cotizaciones nuevas (HU-01 a HU-04)

participant "Planificador o\nPOST /ingesta/sincronizar" as T
participant "ingesta" as ING
participant "drive" as C
participant "Google\nDrive API" as GD
participant "extraccion" as EXT
database "PostgreSQL" as DB

T -> ING : sincronizar_empresa(empresa)
ING -> DB : integración activa de la empresa
DB --> ING : refresh token cifrado
ING -> ING : descifrar (Fernet)
ING -> C : listar_pdfs(carpeta de la empresa)
C -> GD : files.list (OAuth, solo lectura)
GD --> C : archivos
ING -> DB : google_drive_id ya registrados
loop por cada archivo no registrado
  ING -> C : descargar(id)
  C -> GD : files.get_media(id)
  GD --> C : PDF
  ING -> ING : SHA-256 del PDF
  alt mismo hash que otro documento
    ING -> DB : documento(estado = duplicado)
  else contenido nuevo
    ING -> EXT : extraer_texto_pdf + extraer_cotizacion
    alt faltan datos o montos no cuadran
      EXT --> ING : ExtraccionError
      ING -> DB : documento(estado = error, mensaje)
    else número de cotización ya existe
      ING -> DB : documento(estado = duplicado)
    else datos válidos
      ING -> DB : cliente (busca por RUT o crea),\ncotización, ítems y documento(procesado)
    end
  end
end
ING --> T : resumen (encontrados, procesados,\nduplicados, errores, omitidos)
@enduml
