@startuml casos-de-uso-consulta
!include _estilo.iuml
left to right direction
title Cotiza+ · Casos de uso · Épica 002: consulta y visualización segura

actor "Usuario\n(comercial /\nadministración)" as U

rectangle "Cotiza+" {
  usecase "Iniciar sesión\n(HU-05)" as UC1
  usecase "Cerrar sesión\n(HU-05)" as UC2
  usecase "Buscar cotizaciones\n(HU-07)" as UC3
  usecase "Filtrar por cliente\ny año (HU-08)" as UC4
  usecase "Ver detalle de\ncotización (HU-09)" as UC5
  usecase "Abrir PDF original" as UC6
  usecase "Ver indicadores\ncomerciales (HU-10)" as UC7
  usecase "Ver métricas por\nperíodo (HU-11)" as UC8
}

U --> UC1
U --> UC2
U --> UC3
U --> UC5
U --> UC7
UC4 .> UC3 : <<extend>>
UC6 .> UC5 : <<extend>>
UC8 .> UC7 : <<extend>>
UC3 ..> UC1 : <<include>>
UC5 ..> UC1 : <<include>>
UC7 ..> UC1 : <<include>>
@enduml
