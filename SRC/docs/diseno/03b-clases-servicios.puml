@startuml clases-servicios
!include _estilo.iuml
skinparam classAttributeIconSize 0
title Cotiza+ · Diagrama de módulos: ingesta y servicios (app/services, app/api)

package "app.services.drive" {
  class drive <<módulo>> {
    + crear_flow(state, code_verifier): Flow
    + servicio_drive(refresh_token)
    + listar_pdfs(servicio, folder_id): list[dict]
    + descargar(servicio, file_id): bytes
  }
}

package "app.services.extraccion" {
  class extraccion <<módulo>> {
    + extraer_texto_pdf(pdf: bytes): str
    + extraer_cotizacion(texto, rut_empresa): DatosCotizacion
    + extraer_numero / extraer_fecha / extraer_cliente
    + extraer_montos / cuadrar_montos / extraer_items
    + normalizar_rut(rut): str | None
  }
  class DatosCotizacion <<dataclass>> {
    numero, fecha, cliente_nombre, cliente_rut,
    monto_neto, iva, total, items, metodo
  }
  class ExtraccionError <<exception>>
  note bottom of extraccion
    Respaldo con IA (HU-03): punto de conexión
    en extraer_cotizacion, pendiente.
  end note
}

package "app.services.ingesta" {
  class ingesta <<módulo>> {
    + sincronizar_empresa(db, empresa, reintentar_errores): ResumenIngesta
    + sincronizar_todas(db)
    + procesar_pdf(db, empresa, google_drive_id, nombre, contenido): Documento
    + procesar_y_guardar(...): estado
  }
}

package "app.api (FastAPI, /api/v1)" {
  class auth <<router>> {
    POST /auth/login
    GET /auth/me
  }
  class cotizaciones <<router>> {
    GET /cotizaciones
    GET /cotizaciones/{id}
  }
  class clientes <<router>> {
    GET /clientes
  }
  class metricas <<router>> {
    GET /metricas/anios
    GET /metricas/resumen
    GET /metricas/por-periodo
  }
  class ingesta_api <<router>> {
    POST /ingesta/sincronizar
    GET /documentos
  }
  class google_drive <<router>> {
    GET /google/estado
    POST /google/autorizar
    DELETE /google/conexion
    GET /google/callback (público)
  }
  class deps <<módulo>> {
    + usuario_actual(token): Usuario
  }
}

package "app.core" {
  class security <<módulo>> {
    + hashear_password / verificar_password (bcrypt)
    + crear_access_token / decodificar_access_token (JWT)
    + cifrar / descifrar (Fernet)
  }
}

ingesta --> drive
ingesta --> extraccion
extraccion ..> DatosCotizacion : crea
extraccion ..> ExtraccionError : lanza
ingesta_api --> ingesta
google_drive --> drive
google_drive --> security : cifra el token
ingesta --> security : descifra el token
auth --> security
deps --> security
cotizaciones --> deps
clientes --> deps
metricas --> deps
ingesta_api --> deps
@enduml
